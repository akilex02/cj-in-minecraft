+/// Host mode: the collision world made of the quads a host sends (a Minecraft area). A quad lists its corners so that the triangles (0, 2, 1) and (0, 3, 2)
+/// face outwards: (x0, z0), (x1, z0), (x1, z1), (x0, z1) with x1 > x0 and z1 > z0, at one height, is a floor whose solid side is below.
+pub(crate) fn world_from_quads(material: RetailContactMaterial, quads: Vec<[Vector3; 4]>) -> Result<BoardWorld, String> {
+    if quads.is_empty() {
+        return Err("a world needs at least one quad".into());
+    }
+    Ok(build_world(material, [quads, vec![], vec![], vec![]], Vec::new()))
+}
