diff --git a/crates/skate-game/src/host.rs b/crates/skate-game/src/host.rs
new file mode 100644
index 0000000..8c6bb7b
--- /dev/null
+++ b/crates/skate-game/src/host.rs
@@ -0,0 +1,346 @@
+//! Host mode (`--host ADDR`): another program drives the skater over UDP and reads its pose back, one datagram each way per physics tick.
+//! The host sends the 18 gameplay actions (what a controller would give); the engine answers with the skater's bones and the board.
+//! Nothing here touches the simulation itself: the actions replace the controller's in `input::publish_actions`, and the pose is read
+//! after the physics tick has run.
+use crate::{app::SimulationSet, physics::{GamePhysics, SkaterRuntime}};
+use skate_core::math::Vector3;
+use std::collections::HashMap;
+use bevy::prelude::*;
+use skate_core::physics::board::BodyId;
+use std::net::{SocketAddr, UdpSocket};
+
+const MAGIC: u32 = 0x4838_4B53; // "SK8H" in little-endian bytes
+const VERSION: u16 = 1;
+const TYPE_INPUT: u16 = 1;
+const TYPE_POSE: u16 = 2;
+/// A region of the host's world as quads: region id, quad count, then each quad as four corners of three f32 (see `ground::world_from_quads` for the order).
+const TYPE_WORLD_SET: u16 = 3;
+const TYPE_WORLD_CLEAR: u16 = 4; // region id
+/// Put the skater (on the board) somewhere: x, y, z, heading (radians about Y), and its velocity x, y, z.
+const TYPE_TELEPORT: u16 = 5;
+/// The most quads of one region (one datagram of 48 bytes each stays under the 64 KiB of a UDP datagram).
+const MAX_QUADS: usize = 1000;
+const MAX_COORDINATE: f32 = 100_000.0;
+const ACTIONS: usize = 18;
+/// An input older than this is taken as the host having let go of everything.
+const INPUT_TIMEOUT: std::time::Duration = std::time::Duration::from_millis(300);
+/// header (magic, version, type), sequence number, flags (none yet), and the 18 actions as f32.
+const INPUT_SIZE: usize = 8 + 4 + 4 + ACTIONS * 4;
+
+/// The socket and the last input of the host.
+#[derive(Resource)]
+pub(crate) struct HostLink {
+    socket: UdpSocket,
+    peer: Option<SocketAddr>,
+    actions: [f32; ACTIONS],
+    /// When the last input came: a host that went quiet (closed, crashed) must not leave its buttons held.
+    last_input: Option<std::time::Instant>,
+    seq: u32,
+    /// The host's world, by region; rebuilt into the collision world when something changed.
+    regions: HashMap<u32, Vec<[Vector3; 4]>>,
+    world_dirty: bool,
+    teleport: Option<([[f32; 4]; 4], [f32; 3])>,
+}
+
+impl HostLink {
+    pub(crate) fn bind(address: SocketAddr) -> Result<Self, String> {
+        let socket = UdpSocket::bind(address).map_err(|e| format!("--host {address}: {e}"))?;
+        socket.set_nonblocking(true).map_err(|e| format!("--host {address}: {e}"))?;
+        eprintln!("SKATE_HOST_READY listening on {address}");
+        Ok(Self { socket, peer: None, actions: [0.0; ACTIONS], last_input: None, seq: 0, regions: HashMap::new(), world_dirty: false, teleport: None })
+    }
+
+    /// Reads every datagram that is waiting; the newest valid input is the one that counts. Whoever sends one is the host the poses go to.
+    pub(crate) fn drain(&mut self) {
+        let mut buffer = vec![0u8; 65536];
+        while let Ok((len, from)) = self.socket.recv_from(&mut buffer) {
+            let data = &buffer[..len];
+            match kind_of(data) {
+                Some(TYPE_WORLD_SET) => {
+                    if let Some((region, quads)) = parse_world_set(data) {
+                        self.regions.insert(region, quads);
+                        self.world_dirty = true;
+                        self.adopt(from);
+                    }
+                    continue;
+                }
+                Some(TYPE_WORLD_CLEAR) => {
+                    if let Some(region) = parse_world_clear(data) {
+                        self.world_dirty |= self.regions.remove(&region).is_some();
+                    }
+                    continue;
+                }
+                Some(TYPE_TELEPORT) => {
+                    if let Some(teleport) = parse_teleport(data) {
+                        self.teleport = Some(teleport);
+                        self.adopt(from);
+                    }
+                    continue;
+                }
+                _ => {}
+            }
+            if let Some((seq, actions)) = parse_input(data) {
+                // A sequence number that went backwards (the host restarted) is taken: only the very old duplicates are dropped.
+                self.adopt(from);
+                if seq.wrapping_sub(self.seq) as i32 > 0 || self.seq == 0 {
+                    self.actions = actions;
+                    self.seq = seq;
+                }
+                self.last_input = Some(std::time::Instant::now());
+            }
+        }
+    }
+
+    /// Whoever sends is the host the poses go to; a new host (it restarted: another port) starts counting its inputs from the beginning again.
+    fn adopt(&mut self, from: SocketAddr) {
+        if self.peer != Some(from) {
+            self.peer = Some(from);
+            self.seq = 0;
+        }
+    }
+
+    pub(crate) fn actions(&self) -> [f32; ACTIONS] {
+        match self.last_input {
+            Some(at) if at.elapsed() < INPUT_TIMEOUT => self.actions,
+            _ => [0.0; ACTIONS],
+        }
+    }
+}
+
+/// The type of a datagram with a valid header, whatever its body.
+fn kind_of(data: &[u8]) -> Option<u16> {
+    if data.len() < 8
+        || u32::from_le_bytes(data[0..4].try_into().ok()?) != MAGIC
+        || u16::from_le_bytes(data[4..6].try_into().ok()?) != VERSION
+    {
+        return None;
+    }
+    Some(u16::from_le_bytes(data[6..8].try_into().ok()?))
+}
+
+fn read_f32(data: &[u8], offset: usize) -> Option<f32> {
+    let value = f32::from_le_bytes(data.get(offset..offset + 4)?.try_into().ok()?);
+    (value.is_finite() && value.abs() <= MAX_COORDINATE).then_some(value)
+}
+
+fn parse_world_set(data: &[u8]) -> Option<(u32, Vec<[Vector3; 4]>)> {
+    let region = u32::from_le_bytes(data.get(8..12)?.try_into().ok()?);
+    let count = u32::from_le_bytes(data.get(12..16)?.try_into().ok()?) as usize;
+    if count > MAX_QUADS || data.len() != 16 + count * 48 {
+        return None;
+    }
+    let mut quads = Vec::with_capacity(count);
+    for q in 0..count {
+        let mut corners = [Vector3::ZERO; 4];
+        for (c, corner) in corners.iter_mut().enumerate() {
+            let at = 16 + q * 48 + c * 12;
+            *corner = Vector3::new(read_f32(data, at)?, read_f32(data, at + 4)?, read_f32(data, at + 8)?);
+        }
+        quads.push(corners);
+    }
+    Some((region, quads)) // a quad with a broken number refuses the whole datagram: never half a region
+}
+
+fn parse_world_clear(data: &[u8]) -> Option<u32> {
+    (data.len() == 12).then(|| u32::from_le_bytes(data[8..12].try_into().unwrap()))
+}
+
+/// (the matrix `SkaterRuntime::travel` wants, the velocity)
+fn parse_teleport(data: &[u8]) -> Option<([[f32; 4]; 4], [f32; 3])> {
+    if data.len() != 8 + 7 * 4 {
+        return None;
+    }
+    let value = |i: usize| read_f32(data, 8 + i * 4);
+    let (position, heading) = (Vec3::new(value(0)?, value(1)?, value(2)?), value(3)?);
+    let velocity = [value(4)?, value(5)?, value(6)?];
+    let mut matrix = Mat4::from_rotation_translation(Quat::from_rotation_y(heading), position).to_cols_array_2d();
+    matrix[3][3] = 0.0; // as the engine's own teleports hand it over
+    Some((matrix, velocity))
+}
+
+fn parse_input(data: &[u8]) -> Option<(u32, [f32; ACTIONS])> {
+    if data.len() != INPUT_SIZE
+        || u32::from_le_bytes(data[0..4].try_into().ok()?) != MAGIC
+        || u16::from_le_bytes(data[4..6].try_into().ok()?) != VERSION
+        || u16::from_le_bytes(data[6..8].try_into().ok()?) != TYPE_INPUT
+    {
+        return None;
+    }
+    let seq = u32::from_le_bytes(data[8..12].try_into().ok()?);
+    let mut actions = [0.0f32; ACTIONS];
+    for (i, action) in actions.iter_mut().enumerate() {
+        let value = f32::from_le_bytes(data[16 + i * 4..20 + i * 4].try_into().ok()?);
+        if !value.is_finite() {
+            return None; // a broken input is dropped whole, never half taken
+        }
+        *action = value.clamp(-1.0, 1.0);
+    }
+    Some((seq, actions))
+}
+
+pub(crate) struct HostPlugin;
+impl Plugin for HostPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(FixedUpdate, apply_commands.in_set(SimulationSet::Controls))
+            .add_systems(FixedUpdate, send_pose.after(SimulationSet::Physics));
+    }
+}
+
+/// Before the physics tick: the teleport the host asked for, and the host's world when it changed.
+fn apply_commands(mut link: ResMut<HostLink>, mut physics: ResMut<GamePhysics>, mut skater: ResMut<SkaterRuntime>) {
+    if let Some((matrix, velocity)) = link.teleport.take() {
+        if let Err(error) = skater.travel(matrix, Some(velocity)) {
+            warn!("host teleport refused: {error}");
+        }
+    }
+    if link.world_dirty {
+        link.world_dirty = false;
+        let quads: Vec<[Vector3; 4]> = link.regions.values().flatten().copied().collect();
+        if !quads.is_empty() {
+            let started = std::time::Instant::now();
+            match physics.replace_world_with_quads(quads.clone()) {
+                Ok(()) => eprintln!("SKATE_HOST_WORLD quads={} regions={} build_ms={:.2}", quads.len(), link.regions.len(), started.elapsed().as_secs_f64() * 1000.0),
+                Err(error) => warn!("host world refused: {error}"),
+            }
+        }
+    }
+}
+
+/// After every physics tick: the skater's global bone matrices, the root and the deck of the board, to the host that last sent an input.
+fn send_pose(link: Res<HostLink>, physics: Res<GamePhysics>, skater: Res<SkaterRuntime>) {
+    let Some(peer) = link.peer else { return; };
+    if physics.failed {
+        return;
+    }
+    let bones = &skater.render_pose;
+    let mut packet = Vec::with_capacity(8 + 8 + 64 + 48 + bones.len() * 64);
+    packet.extend_from_slice(&MAGIC.to_le_bytes());
+    packet.extend_from_slice(&VERSION.to_le_bytes());
+    packet.extend_from_slice(&TYPE_POSE.to_le_bytes());
+    packet.extend_from_slice(&(physics.ticks as u32).to_le_bytes());
+    packet.extend_from_slice(&(bones.len() as u32).to_le_bytes());
+    let root = crate::animation::native_matrix(skater.animated_skeleton.roots.animation_to_world);
+    for v in root.to_cols_array() {
+        packet.extend_from_slice(&v.to_le_bytes());
+    }
+    let deck = physics.board.part_transforms()[BodyId::Deck.index()];
+    for column in deck.basis.columns {
+        for v in column {
+            packet.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+    for v in [deck.translation.x, deck.translation.y, deck.translation.z] {
+        packet.extend_from_slice(&v.to_le_bytes());
+    }
+    for bone in bones {
+        for v in crate::animation::native_matrix(*bone).to_cols_array() {
+            packet.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+    let _ = link.socket.send_to(&packet, peer); // a lost datagram is the next tick's problem
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn input(seq: u32, actions: [f32; ACTIONS]) -> Vec<u8> {
+        let mut data = Vec::new();
+        data.extend_from_slice(&MAGIC.to_le_bytes());
+        data.extend_from_slice(&VERSION.to_le_bytes());
+        data.extend_from_slice(&TYPE_INPUT.to_le_bytes());
+        data.extend_from_slice(&seq.to_le_bytes());
+        data.extend_from_slice(&0u32.to_le_bytes());
+        for a in actions {
+            data.extend_from_slice(&a.to_le_bytes());
+        }
+        data
+    }
+
+    #[test]
+    fn an_input_is_read_and_clamped() {
+        let mut actions = [0.0; ACTIONS];
+        actions[0] = 0.5;
+        actions[16] = 3.0;
+        let (seq, read) = parse_input(&input(7, actions)).unwrap();
+        assert_eq!(seq, 7);
+        assert_eq!(read[0], 0.5);
+        assert_eq!(read[16], 1.0);
+    }
+
+    #[test]
+    fn a_datagram_that_is_not_an_input_is_refused() {
+        let good = input(1, [0.0; ACTIONS]);
+        assert!(parse_input(&good).is_some());
+        assert!(parse_input(&good[..good.len() - 1]).is_none());
+        let mut wrong = good.clone();
+        wrong[0] ^= 1; // magic
+        assert!(parse_input(&wrong).is_none());
+        let mut wrong = good.clone();
+        wrong[6] = 2; // type
+        assert!(parse_input(&wrong).is_none());
+        let mut nan = [0.0; ACTIONS];
+        nan[5] = f32::NAN;
+        assert!(parse_input(&input(1, nan)).is_none());
+    }
+
+    fn world_set(region: u32, quads: &[[[f32; 3]; 4]]) -> Vec<u8> {
+        let mut data = Vec::new();
+        data.extend_from_slice(&MAGIC.to_le_bytes());
+        data.extend_from_slice(&VERSION.to_le_bytes());
+        data.extend_from_slice(&TYPE_WORLD_SET.to_le_bytes());
+        data.extend_from_slice(&region.to_le_bytes());
+        data.extend_from_slice(&(quads.len() as u32).to_le_bytes());
+        for quad in quads {
+            for corner in quad {
+                for v in corner {
+                    data.extend_from_slice(&v.to_le_bytes());
+                }
+            }
+        }
+        data
+    }
+
+    const FLOOR: [[f32; 3]; 4] = [[-1.0, 2.0, -1.0], [1.0, 2.0, -1.0], [1.0, 2.0, 1.0], [-1.0, 2.0, 1.0]];
+
+    #[test]
+    fn a_region_of_quads_is_read() {
+        let data = world_set(9, &[FLOOR, FLOOR]);
+        assert_eq!(kind_of(&data), Some(TYPE_WORLD_SET));
+        let (region, quads) = parse_world_set(&data).unwrap();
+        assert_eq!((region, quads.len()), (9, 2));
+        assert_eq!(quads[0][1].x, 1.0);
+    }
+
+    #[test]
+    fn a_broken_region_is_refused_whole() {
+        let good = world_set(1, &[FLOOR]);
+        assert!(parse_world_set(&good[..good.len() - 4]).is_none()); // short
+        let mut nan = good.clone();
+        nan[16..20].copy_from_slice(&f32::NAN.to_le_bytes());
+        assert!(parse_world_set(&nan).is_none());
+        let mut far = good.clone();
+        far[20..24].copy_from_slice(&1.0e9f32.to_le_bytes());
+        assert!(parse_world_set(&far).is_none());
+        let too_many = world_set(1, &vec![FLOOR; MAX_QUADS + 1]);
+        assert!(parse_world_set(&too_many).is_none());
+        assert_eq!(parse_world_set(&world_set(1, &vec![FLOOR; MAX_QUADS])).unwrap().1.len(), MAX_QUADS);
+    }
+
+    #[test]
+    fn a_teleport_makes_the_matrix_of_the_engine() {
+        let mut data = Vec::new();
+        data.extend_from_slice(&MAGIC.to_le_bytes());
+        data.extend_from_slice(&VERSION.to_le_bytes());
+        data.extend_from_slice(&TYPE_TELEPORT.to_le_bytes());
+        for v in [1.0f32, 2.0, 3.0, 0.0, 0.5, 0.0, 0.25] {
+            data.extend_from_slice(&v.to_le_bytes());
+        }
+        let (matrix, velocity) = parse_teleport(&data).unwrap();
+        assert_eq!(&matrix[3][..3], &[1.0, 2.0, 3.0]);
+        assert_eq!(matrix[3][3], 0.0);
+        assert_eq!(&matrix[2][..3], &[0.0, 0.0, 1.0]); // heading 0 faces +Z
+        assert_eq!(velocity, [0.5, 0.0, 0.25]);
+        assert!(parse_teleport(&data[..data.len() - 4]).is_none());
+    }
+}
